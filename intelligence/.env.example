# No external model is needed. Bind locally; do not commit actual credentials.
INTELLIGENCE_BIND=127.0.0.1:50053
INTELLIGENCE_DB=output/intelligence.sqlite3
INTELLIGENCE_TOKEN=
# Optional actual Platform-published version UUIDs (defaults are demo-only IDs).
INTELLIGENCE_SIMULATOR_VERSION_ID=
INTELLIGENCE_EVALUATOR_VERSION_ID=
# Set a token to serve requests. Clients use authorization: Bearer <token>.
# For a strictly local demonstration only: --insecure-local
