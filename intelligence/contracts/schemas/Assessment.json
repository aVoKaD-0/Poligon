{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 24000,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 24000,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "error",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "actual": {
          "default": null,
          "title": "Actual"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "applicability": {
          "additionalProperties": true,
          "title": "Applicability",
          "type": "object"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assertion_id",
        "rule_id",
        "status",
        "reason"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "json_pointer": {
          "pattern": "^(/.*)?$",
          "title": "Json Pointer",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "json_pointer"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "attempt_no": {
      "maximum": 4294967295,
      "minimum": 1,
      "title": "Attempt No",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "evaluation_id": {
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "evaluator_version_id": {
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Evaluator Version Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "simulation_validity": {
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ],
      "title": "Simulation Validity",
      "type": "string"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/Assertion"
      },
      "title": "Assertions",
      "type": "array"
    },
    "scores": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Scores",
      "type": "array"
    },
    "completeness": {
      "additionalProperties": true,
      "title": "Completeness",
      "type": "object"
    },
    "usage": {
      "additionalProperties": true,
      "title": "Usage",
      "type": "object"
    }
  },
  "required": [
    "project_id",
    "run_id",
    "session_id",
    "attempt_no",
    "evaluation_id",
    "evaluator_version_id",
    "manifest_sha256",
    "verdict",
    "simulation_validity",
    "assertions",
    "completeness",
    "usage"
  ],
  "title": "Assessment",
  "type": "object"
}
