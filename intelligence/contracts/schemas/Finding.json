    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "family": {
      "title": "Family",
      "type": "string"
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "expected": {
      "title": "Expected"
    },
    "actual": {
      "title": "Actual"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
