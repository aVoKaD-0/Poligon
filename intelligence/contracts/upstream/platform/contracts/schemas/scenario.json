{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_item_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "enum": [
        "text",
        "voice"
      ]
    },
    "environment_version_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "initial_fixture": {
      "type": "object"
    },
    "actor_customer_ref": {
      "type": "string",
      "minLength": 1
    },
    "virtual_clock": {
      "type": "string",
      "format": "date-time"
    },
    "business_timezone": {
      "type": "string",
      "minLength": 1
    },
    "client_goal": {
      "type": "string",
      "minLength": 1
    },
    "client_known_facts": {
      "type": "object"
    },
    "simulator_version_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "fault_rules": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "limits": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_client_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "session_duration_ms": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 1800000
        },
        "budget_minor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_client_turns",
        "max_tool_calls",
        "session_duration_ms"
      ]
    },
    "seed_policy": {
      "type": "object"
    },
    "voice_actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_item_id",
    "title",
    "modality",
    "environment_version_id",
    "template_id",
    "template_version",
    "initial_fixture",
    "actor_customer_ref",
    "virtual_clock",
    "business_timezone",
    "client_goal",
    "client_known_facts",
    "simulator_version_id",
    "fault_rules",
    "assertions",
    "limits",
    "seed_policy"
  ]
}
