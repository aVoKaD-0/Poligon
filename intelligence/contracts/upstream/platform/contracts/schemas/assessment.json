{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "evaluation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "evaluator_version_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "simulation_validity": {
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "inconclusive",
              "error",
              "not_applicable"
            ]
          },
          "expected": {},
          "actual": {},
          "reason": {
            "type": "string"
          },
          "applicability": {},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                },
                "json_pointer": {
                  "type": "string",
                  "pattern": "^(/.*)?$"
                }
              },
              "required": [
                "artifact_id",
                "json_pointer"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "assertion_id",
          "rule_id",
          "required",
          "status",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "completeness": {
      "type": "object"
    },
    "usage": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "session_id",
    "attempt_no",
    "evaluation_id",
    "evaluator_version_id",
    "manifest_sha256",
    "verdict",
    "simulation_validity",
    "assertions",
    "scores",
    "completeness",
    "usage"
  ],
  "additionalProperties": false
}
