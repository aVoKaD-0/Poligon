{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapter": {
      "enum": [
        "http-json-v1",
        "ws-pcm-v1"
      ]
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "credential_ref": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "request_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "config": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "adapter",
    "endpoint"
  ]
}
