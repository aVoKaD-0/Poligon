# Generate a complete local .env with: python3 scripts/local_env.py
APP_ENV=local
DATABASE_URL=postgres://platform:replace@localhost:5432/platform_db?sslmode=disable
PUBLIC_ORIGIN=http://localhost:8080
CREDENTIAL_MASTER_KEY=<base64-encoded-32-byte-key>
RUNNER_SERVICE_TOKEN=<random-32-byte-token>
ENVIRONMENT_SERVICE_TOKEN=<random-32-byte-token>
INTELLIGENCE_SERVICE_TOKEN=<random-32-byte-token>
PLATFORM_SERVICE_TOKEN=<random-32-byte-token>
NATS_URL=nats://localhost:4222
NATS_USER=platform
NATS_PASSWORD=<platform-nats-password>
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_BUCKET=poligon-evidence
ENVIRONMENT_GRPC_ADDR=localhost:9091
INTELLIGENCE_GRPC_ADDR=localhost:9092
AGENT_ALLOWED_HOSTS=localhost
ALLOW_PRIVATE_AGENTS=true
# Optional OIDC for local host process; unset issuer selects local developer auth.
OIDC_ISSUER=
OIDC_CLIENT_ID=poligon-platform
OIDC_CLIENT_SECRET=
# Production also requires service mTLS and S3 TLS.
GRPC_TLS_CA=
GRPC_TLS_CERT=
GRPC_TLS_KEY=
S3_TLS=false
METRICS_TOKEN=<random-32-byte-token>

# Opt-in integration proposal only; leave unset until providers agree on the wire contract.
VALIDATOR_WIRE_MODE=
