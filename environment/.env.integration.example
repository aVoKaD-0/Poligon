# Local single-host integration profile. Set credentials in your private copy.
ENVIRONMENT_MODE=integration
ENVIRONMENT_HTTP_ADDR=127.0.0.1:8081
ENVIRONMENT_GRPC_ADDR=127.0.0.1:9091
ENVIRONMENT_CONTROL_ADDR=127.0.0.1:9090

# Same value as RUNNER_ENVIRONMENT_TOKEN on Runner.
RUNNER_SERVICE_TOKEN=
# Same value as PLATFORM_SERVICE_TOKEN on Platform's validator client.
PLATFORM_SERVICE_TOKEN=
# Same value as ENVIRONMENT_SERVICE_TOKEN on Platform Control.
ENVIRONMENT_CONTROL_TOKEN=
