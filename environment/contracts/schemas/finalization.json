{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context",
    "environment_session_id",
    "snapshot_sha256",
    "snapshot_finalized",
    "audit_complete"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "session_id",
        "attempt_no"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "environment_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.:-]{0,127}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_finalized": {
      "const": true
    },
    "audit_complete": {
      "const": true
    }
  }
}
